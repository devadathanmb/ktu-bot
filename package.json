{
  "name": "ktu-bot",
  "version": "1.0.0",
  "description": "KTU Bot",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:watch": "tsx --watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "db:generate": "NODE_OPTIONS='--import tsx' drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "workers:announcements-notify-worker-dev": "tsx --watch ./src/workers/announcements/notify/startup.ts",
    "workers:announcements-notify-worker": "node dist/workers/announcements/notify/startup.js",
    "workers:broadcasts-worker-dev": "tsx --watch src/workers/broadcasts/startup.ts",
    "workers:broadcasts-worker": "node dist/workers/broadcasts/startup.js",
    "workers:data-sync-worker-dev": "tsx --watch src/workers/data-sync/startup.ts",
    "workers:data-sync-worker": "node dist/workers/data-sync/startup.js",
    "workers:attachment-delivery-worker-dev": "tsx --watch src/workers/attachment-delivery/startup.ts",
    "workers:attachment-delivery-worker": "node dist/workers/attachment-delivery/startup.js",
    "services:bull-board-dev": "tsx --watch src/services/bull-board/server.ts",
    "services:bull-board": "node dist/services/bull-board/server.js",
    "prepare": "husky"
  },
  "keywords": [
    "telegram",
    "bot",
    "ktu",
    "grammy",
    "typescript",
    "telegram bot",
    "ktu bot"
  ],
  "author": "Devadathan M B <devadathanmb@gmail.com>",
  "license": "AGPL-3.0",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "filelist>minimatch": "5.1.8",
      "redis-info>lodash": "4.17.23"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@bull-board/api": "^6.20.3",
    "@bull-board/hono": "^6.20.3",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/commands": "^1.3.2",
    "@grammyjs/emoji": "^1.2.0",
    "@grammyjs/hydrate": "^1.6.0",
    "@grammyjs/parse-mode": "^2.2.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@hono/node-server": "^1.19.13",
    "bullmq": "^5.70.4",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.2",
    "got": "^15.0.3",
    "grammy": "^1.41.1",
    "hono": "^4.12.18",
    "ioredis": "^5.10.0",
    "lru-cache": "^11.3.6",
    "pg": "^8.20.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "responselike": "^4.0.2",
    "string-strip-html": "^13.5.3",
    "zod": "^4.3.6"
  }
}
