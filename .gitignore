# Dependencies
/node_modules

# Certs
/certs

# Build output
/dist

# Env files
# New structure: env/prod/, env/staging/, env/dev/
# Dev env files are tracked (contain default configs)
# Prod/staging are gitignored (contain secrets)
env/prod/.env
env/prod/*.env.swarm
env/prod/db-ca.pem
env/staging/.env
env/staging/*.env.swarm
env/staging/db-ca.pem
env/dev/.env
!env/*/.env.example
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea

# Misc
*.swp
*.swo
*.har

# Logs
*.log
logs/

# Prometheus
prometheus/prometheus.yaml
REFACTOR.md
