# Your Telegram Bot token obtained from @BotFather
BOT_TOKEN="BOT_TOKEN"
BOT_HEALTH_CHECK_PORT=3000

# Type of deployment
NODE_ENV="development"

# A channel that will be used for dumping all file uploads to reuse the generated file ID
# Just create a random channel for your bot and add it there
# See this to find the channel ID — https://gist.github.com/mraaroncruz/e76d19f7d61d59419002db54030ebe35
BOT_FILE_UPLOAD_CHANNEL_ID=-1337

# Enable Prometheus metrics collection and the /metrics endpoint
# Set to "true" only if you have a Prometheus scraper running
ENABLE_PROMETHEUS_METRICS="false"