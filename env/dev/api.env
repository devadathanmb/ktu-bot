# External API configs

# Get from — https://uptimerobot.com/api/
UPTIME_ROBOT_API_KEY="Uptime robot API key"

# Get from — https://uptime.betterstack.com/team/<team-id>/integrations/api
BETTER_UPTIME_API_TOKEN="Better Uptime API token"

# Get the monitor group ID from Better Uptime dashboard (e.g., the group named "KTU Services")
BETTER_UPTIME_MONITOR_GROUP_ID="Your monitor group ID"

# Get from — https://huggingface.co/docs/hub/en/security-tokens
# This is not required and won't anymore. Can skip adding this
HUGGING_FACE_API_TOKEN="Hugging face token"