# PostgreSQL Database Configuration for Development

DATABASE_URI="postgresql://ktu_bot_user:password@ktu-bot-postgres:5432/ktu_bot"
PGSSLMODE=disable
DATABASE_NAME=ktu_bot
DATABASE_USER=ktu_bot_user
DATABASE_PASSWORD=password
DATABASE_PORT=5432
DATABASE_HOST=ktu-bot-postgres

# PostgreSQL Docker Container Environment Variables
POSTGRES_DB=ktu_bot
POSTGRES_USER=ktu_bot_user
POSTGRES_PASSWORD=password