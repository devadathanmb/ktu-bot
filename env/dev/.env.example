# Local dev secrets override
#
# Copy this file to create your local secrets file:
#   cp env/dev/.env.example env/dev/.env
#
# This file is for storing sensitive local development secrets that cannot be
# placed in the dev/*.env files (e.g., personal API keys, tokens, credentials).
#
# This file is listed LAST in Docker Compose dev env_file entries, so any environment
# variables defined here will override values from dev/*.env files.
#
# Add your local secrets below:
