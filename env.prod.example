# Production Environment Variables (Example Template)
# Copy this file to .env and fill in real values. Do NOT commit the filled .env.

############################
# Core Bot
############################
BOT_TOKEN=
BOT_FILE_UPLOAD_CHANNEL_ID=
BOT_HEALTH_CHECK_PORT=3000
NODE_ENV=production

############################
# Database (Use a managed Postgres if possible)
############################
DATABASE_URI=
# Or provide granular values instead of DATABASE_URI
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
PGSSLMODE=require

############################
# Redis
############################
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

############################
# External APIs
############################
UPTIME_ROBOT_API_KEY=
BETTER_UPTIME_API_TOKEN=
BETTER_UPTIME_MONITOR_GROUP_ID=
HUGGING_FACE_API_TOKEN=
GROQ_API_KEY=

############################
# Workers
############################
ANNOUNCEMENTS_NOTIFY_WORKER_HEALTHCHECK_PORT=3001
ANNOUNCEMENTS_NOTIFY_WORKER_CRON_SCHEDULE="*/2 * * * *"
BROADCASTS_WORKER_HEALTHCHECK_PORT=3002
DATA_SYNC_WORKER_HEALTHCHECK_PORT=3003
DATA_SYNC_WORKER_SYNC_SCHEDULE="*/30 * * * *"

############################
# Logging / Misc
############################
DEBUG=
